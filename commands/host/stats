# Entry point


USAGE = """\
Usage: enclave stats [options]

How, when, and how much you use Enclave, from the state it keeps on this
machine: sessions, active time, and tokens per tool, model, and project; an
activity calendar and weekday/hour heatmap; and what the network gateway saw.

Options:
  --since <when>     count only activity from then on: a date (2026-09-01) or
                     a span back from now (7d, 4w, 3m, 1y)
  --tool <name>      only this tool; repeatable, or comma-separated
  --project <text>   only projects whose path contains text
  --top <n>          rows in the model and project lists (default 8)
  --idle <minutes>   gap after which a session counts as idle (default %(idle)d)
  --disk             add disk usage of the state and cache roots; walks every
                     file, so it can take a while on a big cache
  --color <when>     auto (default), always, or never; NO_COLOR is honoured
  --state-dir <dir>  read this state root instead of Enclave's own
  -h, --help         this message

Sessions and tokens come from each tool's own transcripts in its config
store, so they cover sessions with and without a network gateway: Claude Code
and Codex JSONL, Pi session files, OpenCode's database, and Mistral Vibe's
session metadata. Subagents count toward the session that started them.
Antigravity conversations and Pi's experimental durable sessions are counted,
but hold no timing or tokens this command reads. A tool with no transcripts
at all is counted from the gateway's session-start events, which miss every
session it ran without a gateway. The report marks both.

Session time is active time: the gaps between a session's events, where any
gap longer than --idle is a break rather than work. Wall-clock time is the
union of all sessions, so parallel sessions count once; the ratio of the two
is how many sessions ran at once on average. Tokens are deduplicated by
message id, since forks and subagents replay their parent's history, and are
split into uncached input, cache reads, cache writes, and output as each tool
reports them. Ephemeral sessions delete their stores and are not counted.

Nothing under the state, config, or cache roots is modified. Credential
stores (env/, auth/, secrets/, tls/) and the tools' auth files are never
opened; OpenCode's database, which also keeps its account tokens, is queried
for sessions and messages only. Databases are opened immutable, or read from a
private temporary copy while their write-ahead log holds data, so a running
tool is never disturbed. The running-now count asks 'enclave ps --json', and
is left out with --state-dir.

Defined in: %(path)s
"""


def parse_since(value):
    m = re.match(r"^(\d+)([dwmy])$", value.strip())
    if m:
        days = int(m.group(1)) * {"d": 1, "w": 7, "m": 30, "y": 365}[m.group(2)]
        today = datetime.date.today()
        start = today - datetime.timedelta(days=days - 1)
        return time.mktime(start.timetuple())
    try:
        d = datetime.datetime.strptime(value.strip(), "%Y-%m-%d")
    except ValueError:
        raise argparse.ArgumentTypeError("expected a date like 2026-09-01 or a span like 7d, 4w, 3m, 1y") from None
    return time.mktime(d.timetuple())


def positive_int(value):
    try:
        n = int(value)
    except ValueError:
        raise argparse.ArgumentTypeError("expected a positive number") from None
    if n < 1:
        raise argparse.ArgumentTypeError("expected a positive number")
    return n


def parse_args(argv):
    parser = argparse.ArgumentParser(prog="enclave stats", usage="enclave stats [options]", add_help=False)
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("--since", type=parse_since)
    parser.add_argument("--tool", action="append", default=[])
    parser.add_argument("--project")
    parser.add_argument("--top", type=positive_int, default=8)
    parser.add_argument("--idle", type=positive_int, default=IDLE_DEFAULT_MINUTES)
    parser.add_argument("--disk", action="store_true")
    parser.add_argument("--color", choices=("auto", "always", "never"), default="auto")
    parser.add_argument("--state-dir")
    args = parser.parse_args(argv)
    args.idle *= 60
    args.tools = {t.strip() for v in args.tool for t in v.split(",") if t.strip()}
    if args.color == "auto":
        args.color = (sys.stdout.isatty() and not os.environ.get("NO_COLOR")
                      and os.environ.get("TERM") != "dumb")
    else:
        args.color = args.color == "always"
    # Honours COLUMNS, then asks the terminal, then falls back to 100.
    args.width = max(64, min(shutil.get_terminal_size((100, 24)).columns, 120))
    return args


def running_sessions():
    """Containers enclave reports as running, or None when it cannot say."""
    enclave = os.environ.get("ENCLAVE_BIN") or "enclave"
    try:
        proc = subprocess.run([enclave, "ps", "--json"], stdout=subprocess.PIPE,
                              stderr=subprocess.DEVNULL, timeout=10, check=False)
    except (OSError, subprocess.SubprocessError):
        return None
    if proc.returncode != 0:
        return None
    try:
        data = json.loads(proc.stdout or b"[]")
    except ValueError:
        return None
    if not isinstance(data, list):
        return None
    return [c for c in data if isinstance(c, dict) and c.get("status") == "running"]


def main(argv):
    args = parse_args(argv)
    if args.help:
        sys.stdout.write(USAGE % {"idle": IDLE_DEFAULT_MINUTES, "path": os.path.abspath(sys.argv[0])})
        return 0
    started = time.time()
    roots = default_roots()
    if args.state_dir:
        roots["state"] = os.path.abspath(os.path.expanduser(args.state_dir))
    if not os.path.isdir(roots["state"]):
        sys.stderr.write("No Enclave state directory at %s.\n" % roots["state"])
        return 1

    scan = Scan(roots, args.tools, args.project, args.since, args.disk)
    running = None
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    tmpdir = tempfile.mkdtemp(prefix="enclave-stats-", dir=runtime if runtime and real_dir(runtime) else None)
    try:
        discover(scan, tmpdir)
        results = run_jobs(scan.jobs)
    finally:
        shutil.rmtree(tmpdir, ignore_errors=True)
    if not args.state_dir:
        running = running_sessions()
        if running is not None:
            running = [c for c in running
                       if (not args.tools or c.get("tool") in args.tools)
                       and (not args.project or args.project in str(c.get("projectDir") or ""))]
    rep = aggregate(scan, results, args.idle)
    text = render(scan, rep, args, running, time.time() - started)
    try:
        sys.stdout.write(text)
        sys.stdout.flush()
    except BrokenPipeError:
        # Piped into head: the reader has what it wanted.
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
